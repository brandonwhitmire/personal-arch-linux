# mode 3 is Zoom: the whole picture fits inside that monitor.
# xin_N is one screen. xin_-1 would stretch one picture across every monitor.
[xin_0]
file={{ profiles_wallpaper_dir }}/{{ item.wallpaper }}
mode=3
bgcolor=#002A36

[xin_1]
file={{ profiles_wallpaper_dir }}/{{ item.wallpaper }}
mode=3
bgcolor=#002A36
